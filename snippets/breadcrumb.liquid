{% doc %}
  Renders a breadcrumb trail based on the current template.

  Rendered once from `layout/theme.liquid` inside the main element.

  @example
  {% render 'breadcrumb' %}
{% enddoc %}

{{ 'component-breadcrumb.css' | asset_url | stylesheet_tag }}

{%- unless template == 'index'
  or template == 'list-collections'
  or template == '404'
  or template == 'password'
  or template == 'gift_card'
-%}
  <nav class="breadcrumb-wrapper page-width" role="navigation" aria-label="{{ 'general.breadcrumbs.label' | t }}">
    <ol class="breadcrumb__list">
      <li class="breadcrumb__item">
        <a class="breadcrumb__link" href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>

      {%- case template.name -%}
        {%- when 'product' -%}
          {%- if collection and collection.handle -%}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ collection.url }}">{{ collection.title }}</a>
            </li>
          {%- elsif product.collections.size > 0 -%}
            {%- assign breadcrumb_collection = product.collections.first -%}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
            </li>
          {%- endif -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ product.title }}</li>

        {%- when 'collection' -%}
          {%- if current_tags -%}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ collection.url }}">{{ collection.title }}</a>
            </li>
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
              {{- current_tags | join: ', ' -}}
            </li>
          {%- else -%}
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ collection.title }}</li>
          {%- endif -%}

        {%- when 'blog' -%}
          {%- if current_tags -%}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ blog.url }}">{{ blog.title }}</a>
            </li>
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
              {{- current_tags | join: ', ' -}}
            </li>
          {%- else -%}
            <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ blog.title }}</li>
          {%- endif -%}

        {%- when 'article' -%}
          <li class="breadcrumb__item">
            <a class="breadcrumb__link" href="{{ blog.url }}">{{ blog.title }}</a>
          </li>
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ article.title }}</li>

        {%- when 'page' -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ page.title }}</li>

        {%- when 'cart' -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            {{- 'general.breadcrumbs.cart' | t -}}
          </li>

        {%- when 'search' -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">
            {{- 'general.breadcrumbs.search' | t -}}
          </li>

        {%- when 'customers' -%}
          {%- unless template.name == 'account' -%}
            <li class="breadcrumb__item">
              <a class="breadcrumb__link" href="{{ routes.account_url }}">{{ 'general.breadcrumbs.account' | t }}</a>
            </li>
          {%- endunless -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ page_title }}</li>

        {%- else -%}
          <li class="breadcrumb__item breadcrumb__item--current" aria-current="page">{{ page_title }}</li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}
