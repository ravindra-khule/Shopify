{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'component-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection_title = ''
  assign products_count = 0
  if collection
    assign collection_title = collection.title
    assign products_count = collection.products_count
  endif
-%}

<faq-section class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="faq__wrapper">
      {%- if section.settings.caption != blank -%}
        <p class="faq__header caption-with-letter-spacing" style="text-align: {{ section.settings.heading_alignment }};">
          {{ section.settings.caption | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        {%- assign heading = section.settings.heading | replace: '[collection]', collection_title | replace: '[count]', products_count -%}
        <h2
          class="faq__heading inline-richtext {{ section.settings.heading_size }}"
          style="text-align: {{ section.settings.heading_alignment }};"
        >
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="faq__list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign question = block.settings.question | replace: '[collection]', collection_title | replace: '[count]', products_count
              assign answer = block.settings.answer | replace: '[collection]', collection_title | replace: '[count]', products_count
            -%}
            <div class="faq__item accordion" {{ block.shopify_attributes }}>
              <details
                id="Details-{{ block.id }}-{{ section.id }}"
                {% if section.settings.open_first and forloop.first %}
                  open
                {% endif %}
              >
                <summary id="Summary-{{ block.id }}-{{ section.id }}">
                  <h3 class="faq__question accordion__title inline-richtext h4">
                    {{ question | escape }}
                  </h3>
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </summary>
                <div
                  class="accordion__content rte"
                  id="CollapsibleAccordion-{{ block.id }}-{{ section.id }}"
                  role="region"
                  aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
                >
                  {{ answer }}
                </div>
              </details>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.enable_faq_schema and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign schema_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign schema_question = block.settings.question | replace: '[collection]', collection_title | replace: '[count]', products_count | strip_html | strip_newlines | strip
              assign schema_answer = block.settings.answer | replace: '[collection]', collection_title | replace: '[count]', products_count | strip_html | strip_newlines | strip
            -%}
            {%- if schema_question != blank and schema_answer != blank -%}
              {%- if schema_count > 0 %},{% endif -%}
              {
                "@type": "Question",
                "name": {{ schema_question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ schema_answer | json }}
                }
              }
              {%- assign schema_count = schema_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</faq-section>

{% schema %}
{
  "name": "t:sections.faq.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 25,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "caption",
      "label": "t:sections.faq.settings.caption.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.faq.settings.heading.default",
      "label": "t:sections.faq.settings.heading.label",
      "info": "t:sections.faq.settings.heading.info"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.faq.settings.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.faq.settings.heading_alignment.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.faq.settings.heading_alignment.label"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "default": false,
      "label": "t:sections.faq.settings.open_first.label"
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "default": true,
      "label": "t:sections.faq.settings.enable_faq_schema.label",
      "info": "t:sections.faq.settings.enable_faq_schema.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:sections.faq.blocks.question.name",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:sections.faq.blocks.question.settings.question.label",
          "default": "t:sections.faq.blocks.question.settings.question.default",
          "info": "t:sections.faq.blocks.question.settings.question.info"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:sections.faq.blocks.question.settings.answer.label",
          "default": "t:sections.faq.blocks.question.settings.answer.default",
          "info": "t:sections.faq.blocks.question.settings.answer.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "t:sections.faq.presets.q1.question",
            "answer": "t:sections.faq.presets.q1.answer"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "t:sections.faq.presets.q2.question",
            "answer": "t:sections.faq.presets.q2.answer"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "t:sections.faq.presets.q3.question",
            "answer": "t:sections.faq.presets.q3.answer"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "t:sections.faq.presets.q4.question",
            "answer": "t:sections.faq.presets.q4.answer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
