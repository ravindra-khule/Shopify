{{ 'component-guide-links.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #GuideLinks-{{ section.id }} .guide-links__badge {
    color: {{ section.settings.badge_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<guide-links
  id="GuideLinks-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2
        class="guide-links__heading inline-richtext {{ section.settings.heading_size }}"
        style="text-align: {{ section.settings.heading_alignment }};"
      >
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="guide-links__grid" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign guide_article = block.settings.article
            assign card_image = block.settings.image
            if card_image == blank and guide_article != blank
              assign card_image = guide_article.image
            endif
            assign card_title = block.settings.title
            if card_title == blank and guide_article != blank
              assign card_title = guide_article.title
            endif
            assign card_url = block.settings.link
            if card_url == blank and guide_article != blank
              assign card_url = guide_article.url
            endif
          -%}
          <li class="guide-links__item" {{ block.shopify_attributes }}>
            <article class="guide-links__card">
              {%- if card_url != blank -%}
                <a href="{{ card_url }}" class="guide-links__media">
              {%- else -%}
                <div class="guide-links__media">
              {%- endif -%}
              {%- if card_image != blank -%}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 750, 900, 1200',
                    sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)',
                    class: 'guide-links__image',
                    alt: card_title
                }}
              {%- else -%}
                {%- assign placeholder_index = forloop.index | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_index -%}
                {{ placeholder_image | placeholder_svg_tag: 'guide-links__image placeholder-svg' }}
              {%- endif -%}
              {%- if card_url != blank -%}
                </a>
              {%- else -%}
                </div>
              {%- endif -%}
              <div class="guide-links__content">
                {%- if block.settings.badge != blank -%}
                  <p class="guide-links__badge">{{ block.settings.badge | escape }}</p>
                {%- endif -%}
                {%- if card_title != blank -%}
                  <h3 class="guide-links__title">
                    {%- if card_url != blank -%}
                      <a href="{{ card_url }}">{{ card_title | escape }}</a>
                    {%- else -%}
                      {{ card_title | escape }}
                    {%- endif -%}
                  </h3>
                {%- endif -%}
                {%- if card_url != blank and block.settings.link_label != blank -%}
                  <a href="{{ card_url }}" class="guide-links__link">{{ block.settings.link_label | escape }}</a>
                {%- endif -%}
              </div>
            </article>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</guide-links>

{% schema %}
{
  "name": "t:sections.guide-links.name",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.guide-links.settings.heading.default",
      "label": "t:sections.guide-links.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.guide-links.settings.heading_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.guide-links.settings.heading_alignment.options__2.label"
        }
      ],
      "default": "center",
      "label": "t:sections.guide-links.settings.heading_alignment.label"
    },
    {
      "type": "color",
      "id": "badge_color",
      "default": "#1a7f37",
      "label": "t:sections.guide-links.settings.badge_color.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "t:sections.guide-links.blocks.guide.name",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "t:sections.guide-links.blocks.guide.settings.article.label",
          "info": "t:sections.guide-links.blocks.guide.settings.article.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.guide-links.blocks.guide.settings.image.label",
          "info": "t:sections.guide-links.blocks.guide.settings.image.info"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:sections.guide-links.blocks.guide.settings.badge.label",
          "default": "t:sections.guide-links.blocks.guide.settings.badge.default",
          "info": "t:sections.guide-links.blocks.guide.settings.badge.info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.guide-links.blocks.guide.settings.title.label",
          "info": "t:sections.guide-links.blocks.guide.settings.title.info"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.guide-links.blocks.guide.settings.link.label",
          "info": "t:sections.guide-links.blocks.guide.settings.link.info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.guide-links.blocks.guide.settings.link_label.label",
          "default": "t:sections.guide-links.blocks.guide.settings.link_label.default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.guide-links.presets.name",
      "blocks": [
        {
          "type": "guide",
          "settings": {
            "badge": "t:sections.guide-links.presets.guide_1.badge",
            "title": "t:sections.guide-links.presets.guide_1.title"
          }
        },
        {
          "type": "guide",
          "settings": {
            "badge": "t:sections.guide-links.presets.guide_2.badge",
            "title": "t:sections.guide-links.presets.guide_2.title"
          }
        },
        {
          "type": "guide",
          "settings": {
            "badge": "t:sections.guide-links.presets.guide_3.badge",
            "title": "t:sections.guide-links.presets.guide_3.title"
          }
        }
      ]
    }
  ]
}
{% endschema %}
